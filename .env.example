# --- Select which provider powers all four agents ---
MODEL_PROVIDER=google          # google | groq | openrouter

# --- Provider credentials (only the one matching MODEL_PROVIDER is required) ---
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Model overrides (optional — sensible defaults are set in config.py) ---
GOOGLE_MODEL_NAME=gemini-3.5-flash-lite
GROQ_MODEL_NAME=openai/gpt-oss-120b
OPENROUTER_MODEL_NAME=openrouter/auto

# --- Pipeline behaviour ---
USE_EMAIL=true
HOW_MANY_SEARCHES=5
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
REPORTS_DIR=reports
LOG_LEVEL=INFO

# --- Email / push (optional — only needed if USE_EMAIL=true) ---
# Used by messenger.py. Leave blank and set USE_EMAIL=false to skip.
EMAIL_ADDRESS=
EMAIL_SMTP_SERVER=
EMAIL_APP_PASSWORD=
PUSHOVER_USER=
PUSHOVER_TOKEN=
# Set to 0 and provide OPENAI_API_KEY if you want OpenAI trace export.
OPENAI_AGENTS_DISABLE_TRACING=1